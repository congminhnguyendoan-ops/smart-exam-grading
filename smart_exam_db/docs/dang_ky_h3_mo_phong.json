 "tieu_chi_bat_buoc": {
  "T1": "Số ca hệ thống NHẬN (không cần xem) trường đã bị xoá bubble = 0. Ảnh bị từ chối khi nắn tính riêng, không tính là nhận.",
  "T2": "Số phiếu tự chốt sai hoặc có điểm chính thức sai = 0 (sau giáo viên oracle: câu cần xem chốt theo nhãn, SBD / mã đề chốt theo chữ viết tay đúng).",
  "T3": "Đối chứng: trường KHÔNG sửa của mỗi ảnh chỉnh giống kết quả đợt 2 (data/_eval/dot2/that/ket_qua.json): cần xem + lý do của trường; từng cột: bubble, chữ số CNN, cần xem, lý do."
 },
 "kiem_cong_cu": {
  "KT0": "Không phải tiêu chí: 20 ảnh gốc lưu PNG không mất mát, KHÔNG sửa, tải vào kỳ thi riêng C/D cùng giao dịch ROLLBACK; cả hai trường phải giống đợt 2. Tách lệch do công cụ (đường PNG) với lệch do chỗ sửa."
 },
 "du_doan": {
  "T1": "20/20 cần xem (0 nhận)",
  "T2": "0",
  "T3": "khớp ≥ 19/20",
  "KT0": "20/20"
 },
 "mot_lan": "Chạy MỘT lần: python tools/eval_h3_mo_phong.py run --xac-nhan-h3. Khoá data/_eval/h3/da_chay.lock tạo NGAY khi bắt đầu (có rồi thì từ chối, kể cả lỗi giữa chừng). Lỗi kỹ thuật (không phải kết quả) -> báo cáo trước khi chạy lại.",
 "ghi_chu": "Phép thử bằng ẢNH CHỈNH (chép điểm ảnh) – không phản ánh đặc tính quang học thật của ô trống trên giấy."
}
