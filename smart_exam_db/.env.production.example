# Mẫu cấu hình BẢN CÔNG KHAI (lệnh AU – T4). Sao chép thành .env (hoặc truyền biến vào container) rồi điền giá trị thật. KHÔNG commit .env.
# Cách sinh bí mật:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# Tài liệu từng bước: docs/trien_khai_public.md

# ---- BẮT BUỘC ----
# Bật kiểm tra khi khởi động: backend TỪ CHỐI chạy nếu AUTH_MODE != on, COOKIE_SECURE != 1, AUTH_SECRET < 32 ký tự, hoặc WEB_CONCURRENCY > 1.
MOI_TRUONG=production
DATABASE_URL=postgresql://smart_exam_app:DOI_MAT_KHAU_MANH@db:5432/smart_exam
# Khoá ký phiên đăng nhập (≥ 32 ký tự, BÍ MẬT, khác nhau giữa các môi trường)
AUTH_SECRET=DOI_BANG_CHUOI_NGAU_NHIEN_DAI_HON_32_KY_TU
AUTH_MODE=on
COOKIE_SECURE=1
# Địa chỉ HTTPS công khai (QR trang bìa kỳ thi dùng địa chỉ này)
PUBLIC_BASE_URL=https://thi.truong.edu.vn

# ---- Mật khẩu role CSDL: chỉ cho docker-compose (khởi tạo postgres) và tools/khoi_tao_db_san_xuat.py; phải trùng mật khẩu trong DATABASE_URL ----
POSTGRES_PASSWORD=DOI_MAT_KHAU_MANH

# ---- Giới hạn tài nguyên (mặc định thích hợp cho 1–2 GB RAM) ----
# Mỗi ảnh đang chấm ~150 MB RAM; 4 ảnh cùng lúc ≈ 600 MB đỉnh. Máy 1 GB: đặt 2.
CHAM_DONG_THOI=4
CHAM_CHO_GIAY=30
MAX_UPLOAD_MB=25
MAX_ANH_MOI_LO=30
MAX_DIEM_ANH=60000000

# ---- Tắt thông tin lộ ra ngoài ----
DOCS_ENABLED=0
HEALTH_CHI_TIET=0

# ---- Sau proxy (Caddy / nginx trong docker-compose): chỉ tin X-Forwarded-For từ mạng nội bộ của docker ----
# Điền dải mạng của docker (xem docs/trien_khai_public.md mục 6). KHÔNG dùng '*' khi cổng 8000 có thể truy cập trực tiếp từ ngoài.
FORWARDED_ALLOW_IPS=172.16.0.0/12

# ---- Lưu ảnh ----
STORAGE_DIR=/app/storage
SESSION_HOURS=8
# Dọn ảnh tạm TẮT (mặc định). Chỉ bật khi hiểu rõ: ANH_XOA_TU_DONG=1 xoá ảnh phiếu đã chốt sau ANH_GIU_GIO giờ ở MỌI kỳ thi không có "[DEMO".
ANH_XOA_TU_DONG=0
ANH_GIU_GIO=24

# ---- KHÔNG đặt trong production ----
# WEB_CONCURRENCY (> 1 bị từ chối), DEMO_USER, AUTH_MODE=demo
