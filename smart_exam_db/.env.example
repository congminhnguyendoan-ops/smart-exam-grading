# Sao chép thành .env (smart_exam_db/.env – đã nằm trong .gitignore) rồi điền thông tin thật. KHÔNG commit .env.
DATABASE_URL=postgresql://smart_exam_app:DOI_MAT_KHAU@localhost:5432/smart_exam
# Mật khẩu của smart_exam_app CHỈ cho database/run_all.bat / run_all.sh (tạo lại CSDL từ đầu). Phải trùng mật khẩu trong DATABASE_URL ở trên.
# Không có thì run_all dừng ngay, không dùng mật khẩu mặc định. Role đã có thì run_all KHÔNG đổi mật khẩu của nó.
SMART_EXAM_DB_PASSWORD=DOI_MAT_KHAU
# Thư mục lưu ảnh phiếu (tương đối so với smart_exam_db/ hoặc đường dẫn tuyệt đối); CSDL chỉ lưu đường dẫn tương đối
STORAGE_DIR=storage
# Mô hình OMR (JSON, xem models/)
OMR_MODEL=models/omr_m1.json
OCR_MODEL=models/ocr_cnn.json
# Đăng nhập. AUTH_MODE=on (mặc định, an toàn) | demo (chỉ dev/test: bỏ đăng nhập, dùng DEMO_USER hoặc header X-User, KHÔNG kiểm quyền)
AUTH_MODE=on
# Khoá ký phiên đăng nhập (≥ 32 ký tự, BÍ MẬT, không commit). Sinh:  python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET=DOI_BANG_CHUOI_NGAU_NHIEN_DAI
# Hạn phiên (giờ) và cờ Secure của cookie (đặt 1 khi chạy sau https)
SESSION_HOURS=8
COOKIE_SECURE=0
# Chỉ dùng khi AUTH_MODE=demo: username ghi vào created_by / reviewed_by
DEMO_USER=gv_an
MAX_UPLOAD_MB=25
# Địa chỉ gốc in trong mã QR của trang bìa kỳ thi (/m?kythi=<id>). Bỏ trống = lấy từ địa chỉ đang mở trang (localhost thì điện thoại KHÔNG mở được).
# Chạy LAN: http://192.168.1.5:8000 · Sau khi deploy: https://thi.truong.edu.vn
PUBLIC_BASE_URL=
# Ảnh tạm (docs/thiet_ke_chup_dien_thoai.md mục 7): giữ ảnh bao nhiêu giờ sau khi phiếu được chốt; giữ ảnh kỳ thi "[DEMO…]" (1 = giữ)
ANH_GIU_GIO=24
ANH_GIU_DEMO=1
# Giới hạn chấm ảnh ĐỒNG THỜI (lệnh AR – R5): tối đa N ảnh được chấm cùng lúc (mỗi ảnh ~150 MB bộ nhớ); yêu cầu dư chờ tối đa CHAM_CHO_GIAY giây rồi nhận 503 + Retry-After.
# Mặc định 4 / 30 (≥ 2 để hàng đợi tải 2 lượt của giao diện không bao giờ phải chờ).
CHAM_DONG_THOI=4
CHAM_CHO_GIAY=30
# KHÔNG đặt ANH_XOA_TU_DONG=1 ở đây: dọn ảnh tạm chỉ bật bằng tools/chay_server_lan.py --bat-don-anh (khi chủ ý); đặt trong .env thì `uvicorn backend.main:app` gọi trực tiếp cũng dọn ảnh thật.

# Lệnh AU – T1: trang tài liệu tự sinh (/docs, /redoc, /openapi.json) – mặc định TẮT (404); đặt 1 khi dev. /health: mặc định chỉ trạng thái; 1 = thêm phiên bản + SHA mô hình.
DOCS_ENABLED=0
HEALTH_CHI_TIET=0
# Lệnh AU – T3: giới hạn tải lên (MAX_UPLOAD_MB ở trên = tối đa MỘT ảnh; vượt -> 413 trước khi đọc cả tệp). Số ảnh tối đa mỗi lô; số điểm ảnh tối đa (đọc từ tiêu đề, không giải mã).
MAX_ANH_MOI_LO=30
MAX_DIEM_ANH=60000000
# Lệnh AU – T2: sau proxy (Caddy / nginx): chỉ tin X-Forwarded-For từ các IP này (phân tách bằng dấu phẩy). Trống = không tin header nào.
FORWARDED_ALLOW_IPS=
