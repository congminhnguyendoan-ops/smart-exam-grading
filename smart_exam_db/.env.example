# Sao chép thành .env (smart_exam_db/.env – đã nằm trong .gitignore) rồi điền thông tin thật. KHÔNG commit .env.
DATABASE_URL=postgresql://smart_exam_app:DOI_MAT_KHAU@localhost:5432/smart_exam
# Thư mục lưu ảnh phiếu (tương đối so với smart_exam_db/ hoặc đường dẫn tuyệt đối); CSDL chỉ lưu đường dẫn tương đối
STORAGE_DIR=storage
# Mô hình OMR (JSON, xem models/)
OMR_MODEL=models/omr_m1.json
OCR_MODEL=models/ocr_cnn.json
# Tạm thay đăng nhập: username giáo viên được ghi vào created_by / reviewed_by (nợ kỹ thuật: auth thật ở Tuần 7–8)
DEMO_USER=gv_an
MAX_UPLOAD_MB=25
