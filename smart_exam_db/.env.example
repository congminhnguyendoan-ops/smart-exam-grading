# Sao chép thành .env (smart_exam_db/.env – đã nằm trong .gitignore) rồi điền thông tin thật. KHÔNG commit .env.
DATABASE_URL=postgresql://smart_exam_app:DOI_MAT_KHAU@localhost:5432/smart_exam
# Thư mục lưu ảnh phiếu (tương đối so với smart_exam_db/ hoặc đường dẫn tuyệt đối); CSDL chỉ lưu đường dẫn tương đối
STORAGE_DIR=storage
# Mô hình OMR (JSON, xem models/)
OMR_MODEL=models/omr_m1.json
OCR_MODEL=models/ocr_cnn.json
# Đăng nhập. AUTH_MODE=on (mặc định, an toàn) | demo (chỉ dev/test: bỏ đăng nhập, dùng DEMO_USER hoặc header X-User, KHÔNG kiểm quyền)
AUTH_MODE=on
# Khoá ký phiên đăng nhập (≥ 32 ký tự, BÍ MẬT, không commit). Sinh:  python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET=DOI_BANG_CHUOI_NGAU_NHIEN_DAI
# Hạn phiên (giờ) và cờ Secure của cookie (đặt 1 khi chạy sau https)
SESSION_HOURS=8
COOKIE_SECURE=0
# Chỉ dùng khi AUTH_MODE=demo: username ghi vào created_by / reviewed_by
DEMO_USER=gv_an
MAX_UPLOAD_MB=25
